# Bonvoy credentials — never commit the real .env
MARRIOTT_EMAIL=
MARRIOTT_PASSWORD=

# Public origin for OAuth redirects and /confirm/{id} (HTTPS in production)
MARRIOTT_PUBLIC_BASE=http://127.0.0.1:8099
MARRIOTT_GROK_MCP_HOST=127.0.0.1
MARRIOTT_GROK_MCP_PORT=8099

# Optional: extra static bearer for local probes
# GROK_MCP_TOKEN=
