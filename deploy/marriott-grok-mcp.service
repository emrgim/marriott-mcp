[Unit]
Description=Marriott MCP (Streamable HTTP + OAuth)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/marriott-mcp
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=MARRIOTT_PUBLIC_BASE=http://127.0.0.1:8099
Environment=MARRIOTT_GROK_MCP_HOST=127.0.0.1
Environment=MARRIOTT_GROK_MCP_PORT=8099
EnvironmentFile=-%h/marriott-mcp/.env
ExecStart=%h/marriott-mcp/.venv/bin/python %h/marriott-mcp/src/grok_http.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
